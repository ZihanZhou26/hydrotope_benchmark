==== chamber 5 ====
  free a,b,c = {7/2, 8/3, 10/3}
  all w  = {-5.064327485380117, 3.5, 2.6666666666666665, 3.3333333333333335, -4.435672514619883}
  w^2    = {25.6474128791765, 12.25, 7.111111111111111, 11.111111111111112, 19.675190656954275}
  ascending w^2 leg order: {3, 4, 2, 5, 1}
  P5 (factored) = (-16*a*(a*b + b^2 + a*c + b*c + c^2)*(a^4 - 2*a^2*b^2 + b^4 - 2*a^2*c^2 + c^4))/(a + b + c)
  numerator = -16*a*(a*b + b^2 + a*c + b*c + c^2)*(a^4 - 2*a^2*b^2 + b^4 - 2*a^2*c^2 + c^4)
  denominator = a + b + c

