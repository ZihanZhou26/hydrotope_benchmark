  P5 (factored) = (32*a*b^2*c^2*(a*b + b^2 + a*c + b*c + c^2))/(a + b + c)
  numerator = 32*a*b^2*c^2*(a*b + b^2 + a*c + b*c + c^2)
  denominator = a + b + c

==== chamber 3 ====
  free a,b,c = {8/5, 18/7, 3/4}
  all w  = {-2.92955629276384, 1.6, 2.5714285714285716, 0.75, -1.9918722786647316}
  w^2    = {8.582300072472215, 2.5600000000000005, 6.612244897959185, 0.5625, 3.96755517451303}
  ascending w^2 leg order: {4, 2, 5, 3, 1}
  P5 (factored) = (16*a*c^2*(2*a^2 - c^2)*(a*b + b^2 + a*c + b*c + c^2))/(a + b + c)
  numerator = 16*a*c^2*(2*a^2 - c^2)*(a*b + b^2 + a*c + b*c + c^2)
  denominator = a + b + c

==== chamber 4 ====
