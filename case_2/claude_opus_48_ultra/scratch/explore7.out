==== chamber 1 ====
  free a,b,c = {32/7, 29/4, 38/7}
  all w  = {-10.396997929606625, 4.571428571428571, 7.25, 5.428571428571429, -6.853002070393375}
  w^2    = {108.09756594824445, 20.897959183673468, 52.5625, 29.469387755102044, 46.96363737681588}
  ascending w^2 leg order: {2, 4, 5, 3, 1}
  P5 (factored) = (16*a^5*(a*b + b^2 + a*c + b*c + c^2))/(a + b + c)
  numerator = 16*a^5*(a*b + b^2 + a*c + b*c + c^2)
  denominator = a + b + c

==== chamber 2 ====
