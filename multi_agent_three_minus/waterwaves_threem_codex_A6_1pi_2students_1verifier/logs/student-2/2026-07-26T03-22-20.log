def section3_pair_walls(oracle: BGOracle):
    t = sp.Symbol("t")
    base_choices = [
        (Fraction(10, 1), Fraction(2, 1), Fraction(3, 1)),
        (Fraction(12, 1), Fraction(1, 1), Fraction(4, 1)),
        (Fraction(14, 1), Fraction(3, 1), Fraction(2, 1)),
        (Fraction(16, 1), Fraction(2, 1), Fraction(5, 1)),
    ]

    def wall_attempts():
        for triple in base_choices:
            yield triple
        for B in range(8, 28):
            Bf = Fraction(B, 1)
            for c in [Fraction(1, 1), Fraction(2, 1), Fraction(3, 1), Fraction(4, 1)]:
                for e in [Fraction(1, 1), Fraction(2, 1), Fraction(3, 1), Fraction(4, 1)]:
                    yield (Bf, c, e)

    def collect_wall(B, c, e):
        t0 = B / 2
        left_t = [t0 - Fraction(k, 120) for k in range(1, 13)]
        right_t = [t0 + Fraction(k, 120) for k in range(1, 13)]

        ok = True
        left_samples = []
        right_samples = []
        base_left = None
        base_right = None

        for tv in left_t:
            try:
                p = SixPoint(tv, c, B - tv, e)
            except Exception:
                ok = False
                break
            if not p.is_generic():
                ok = False
                break
            pair_sign = tuple(p.sign_maps()[0].items())
            triple_sign = tuple(p.sign_maps()[1].items())
            if base_left is None:
                base_left = (pair_sign, triple_sign)
            elif base_left != (pair_sign, triple_sign):
                ok = False
                break
            res, ferr = safe_on_shell(oracle, 6, [p.b, p.c, p.d, p.e])
            if res is None:
                ok = False
                break
            omega, ar, ai = res
            R, _, _ = wall_pole_subtracted(p, ai)
            left_samples.append((tv, ai * p.C, ai, p, R))
        if not ok:
            return {"wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)}, "status": "rejected_cell_criterion"}

        for tv in right_t:
            try:
                p = SixPoint(tv, c, B - tv, e)
            except Exception:
                ok = False
                break
            if not p.is_generic():
                ok = False
                break
            pair_sign = tuple(p.sign_maps()[0].items())
            triple_sign = tuple(p.sign_maps()[1].items())
            if base_right is None:
                base_right = (pair_sign, triple_sign)
            elif base_right != (pair_sign, triple_sign):
                ok = False
                break
            res, ferr = safe_on_shell(oracle, 6, [p.b, p.c, p.d, p.e])
            if res is None:
                ok = False
                break
            omega, ar, ai = res
            R, _, _ = wall_pole_subtracted(p, ai)
            right_samples.append((tv, ai * p.C, ai, p, R))
        if not ok:
            return {"wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)}, "status": "rejected_cell_criterion"}

        if base_left is None or base_right is None:
            return {"wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)}, "status": "rejected_signs"}

        left_pair, left_triple = dict(base_left[0]), dict(base_left[1])
        right_pair, right_triple = dict(base_right[0]), dict(base_right[1])

        flipped_ok = False
        if "q_2_4" in left_pair and "q_2_4" in right_pair and left_pair["q_2_4"] != right_pair["q_2_4"]:
            flipped_ok = True
        # permit target key variant from indexing differences
        for k, lv in left_pair.items():
            rv = right_pair.get(k, lv)
            if k != "q_2_4" and lv != rv:
                ok = False
        for k, lv in left_triple.items():
            rv = right_triple.get(k, lv)
            if lv != rv:
                ok = False
        if not ok or not flipped_ok:
            outputs.append({
                "wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)},
                "status": "wall_isolation_failed",
            })
            continue

        lf = rational_poly_fit([(x[0], x[1]) for x in left_samples], t, 11)
        rf = rational_poly_fit([(x[0], x[1]) for x in right_samples], t, 11)
        if lf["status"] != "ok" or rf["status"] != "ok":
            outputs.append({
                "wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)},
                "status": "fit_failed",
                "left": lf.get("status"),
                "right": rf.get("status"),
            })
            continue

        Bleft = lf["poly"].as_expr()
        Bright = rf["poly"].as_expr()
        D_B = sp.expand(Bleft - Bright)
        C_poly = symbolic_C_poly(Fraction(0), B, c, e).as_expr()
        C_expr = C_poly.as_expr()

        quotient, rem = sp.div(D_B, C_expr)
        divisible = sp.expand(rem) == 0

        J = sp.cancel(D_B / C_expr)
        num, den = sp.together(J).as_numer_denom()
        fac = sp.factor_list(num)
        qfac = sp.expand(t - t0)
        mult = 0
        q24 = sp.expand((B - t) ** 2 - t ** 2)
        work = sp.Poly(num, t, domain="QQ")
        qpoly = sp.Poly(q24, t, domain="QQ")
        while work.degree() >= 2:
            qout, qrem = sp.div(work, qpoly)
            if not qrem.is_zero:
                break
            mult += 1
            work = qout
        try:
            H0 = sp.limit(J / (q24 ** mult), t, t0) if mult > 0 else sp.limit(J, t, t0)
        except Exception:
            H0 = None

        hold_t = [t0 - Fraction(1, 240), t0 - Fraction(1, 210), t0 - Fraction(1, 180), t0 + Fraction(1, 180), t0 + Fraction(1, 210), t0 + Fraction(1, 240)]
        hold_out = []
        hold_failed = False
        for tv in hold_t:
            p = SixPoint(tv, c, B - tv, e)
            res, ferr = safe_on_shell(oracle, 6, [p.b, p.c, p.d, p.e])
            if res is None:
                ok = False
                hold_failed = True
                break
            omega, ar, ai = res
            obs = ai * p.C
            predL = lf["poly"].eval(sp.Rational(tv.numerator, tv.denominator))
            predR = rf["poly"].eval(sp.Rational(tv.numerator, tv.denominator))
            pl = Fraction(int(predL.as_numer_denom()[0]), int(predL.as_numer_denom()[1]))
            pr = Fraction(int(predR.as_numer_denom()[0]), int(predR.as_numer_denom()[1]))
            hold_out.append({
                "t": frac_to_str(tv),
                "obs_B": frac_to_str(obs),
                "pred_left": frac_to_str(pl),
                "pred_right": frac_to_str(pr),
                "res_left": frac_to_str(pl - obs),
                "res_right": frac_to_str(pr - obs),
            })
        if hold_failed:
            outputs.append({
                "wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)},
                "status": "holdout_eval_failed",
            })
            continue

        # fit R = amp_im - pole on each side, 9-point polynomial and holdout checks
        holdout_minimum = 3
        rlf = rational_poly_fit([(x[0], x[4]) for x in left_samples[:9]], t, 8)
        rrf = rational_poly_fit([(x[0], x[4]) for x in right_samples[:9]], t, 8)
        if rlf["status"] != "ok" or rrf["status"] != "ok":
            outputs.append({
                "wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)},
                "t0": frac_to_str(t0),
                "status": "subtracted_fit_failed",
                "left": rlf.get("status"),
                "right": rrf.get("status"),
                "unsubtracted": {
                    "left_fit": {"deg": lf["deg"], "expr": lf["expr"]},
                    "right_fit": {"deg": rf["deg"], "expr": rf["expr"]},
                    "C_poly": str(C_expr),
                    "divisible_by_C": divisible,
                    "J": str(J),
                    "J_factorization": str(sp.factor(num)),
                    "J_factor_list": [[str(f), int(e)] for f, e in fac[1]],
                    "q24_multiplicity": mult,
                    "holdout": hold_out,
                    "quotient": str(sp.expand(quotient)),
                    "remainder": str(sp.expand(rem)),
                }
            })
            continue

        JR = sp.expand(rlf["poly"].as_expr() - rrf["poly"].as_expr())
        JR_num, JR_den = sp.together(JR).as_numer_denom()
        fac_num = sp.factor_list(JR_num)[1]
        den_fac = sp.factor_list(JR_den)[1]
        q24 = sp.expand((B - t) ** 2 - t ** 2)
        try:
            q24_mul = v_poly_multiplicity(JR_num, q24) - v_poly_multiplicity(JR_den, q24)
        except Exception:
            q24_mul = 0

        try:
            H0r = sp.limit(JR / (q24 ** q24_mul), t, t0)
            H0r_s = str(H0r)
        except Exception:
            H0r_s = None
        try:
            JRr = sp.together(JR / (q24 ** q24_mul))
            JR_num2, JR_den2 = sp.together(JRr).as_numer_denom()
            if sp.Poly(sp.expand(JR_den2), t, domain="QQ").is_constant():
                qdeg = sp.Poly(sp.expand(JR_num2), t, domain="QQ").total_degree()
            else:
                qdeg = None
            qexpr = str(sp.expand(JRr))
            qrem = str("0" if JR_den2 == 1 else str(sp.together(JRr)))
        except Exception:
            qdeg = None
            qexpr = str(JR)
            qrem = "0"

        rhold = []
        # holdout points for R are six nearby points around wall, all off-wall
        for tv in hold_t:
            p = SixPoint(tv, c, B - tv, e)
            res, ferr = safe_on_shell(oracle, 6, [p.b, p.c, p.d, p.e])
            if res is None:
                continue
            omega, ar, ai = res
            R = wall_pole_subtracted(p, ai)[0]
            pred_l = rlf["poly"].eval(sp.Rational(tv.numerator, tv.denominator))
            pred_r = rrf["poly"].eval(sp.Rational(tv.numerator, tv.denominator))
            pl = Fraction(int(pred_l.as_numer_denom()[0]), int(pred_l.as_numer_denom()[1]))
            pr = Fraction(int(pred_r.as_numer_denom()[0]), int(pred_r.as_numer_denom()[1]))
            rhold.append({
                "t": frac_to_str(tv),
                "obs_R": frac_to_str(R),
                "pred_left_R": frac_to_str(pl),
                "pred_right_R": frac_to_str(pr),
                "res_left_R": frac_to_str(pl - R),
                "res_right_R": frac_to_str(pr - R),
            })

        outputs.append({
            "wall": {"B": frac_to_str(B), "c": frac_to_str(c), "e": frac_to_str(e)},
            "t0": frac_to_str(t0),
            "status": "ok",
            "left_fit": {"deg": lf["deg"], "expr": lf["expr"]},
            "right_fit": {"deg": rf["deg"], "expr": rf["expr"]},
            "C_poly": str(C_expr),
            "divisible_by_C": divisible,
            "J": str(J),
            "J_factorization": str(sp.factor(num)),
            "J_factor_list": [[str(f), int(e)] for f, e in fac[1]],
            "q24_multiplicity": mult,
            "H0": str(sp.limit(J, t, t0)) if t0 is not None else None,
            "quotient": str(sp.expand(quotient)),
            "remainder": str(sp.expand(rem)),
            "holdout": hold_out,
            "subtracted": {
                "left_fit": {"deg": rlf["deg"], "expr": rlf.get("expr")},
                "right_fit": {"deg": rrf["deg"], "expr": rrf.get("expr")},
                "J_R": str(JR),
                "J_R_factorization_num": [[str(f), int(e)] for f, e in fac_num],
                "J_R_factorization_den": [[str(f), int(e)] for f, e in den_fac],
                "q24_multiplicity": q24_mul,
                "q24_expr": str(q24),
                "H0_R": H0r_s,
                "quotient_degree": qdeg,
                "quotient": qexpr,
                "remainder": qrem,
                "holdout": rhold,
                "holdout_exact_points": len(rhold),
                "left_residual_points": poly_residuals(rlf["poly"], t, [(x[0], x[4]) for x in left_samples[9:12] if len(left_samples) >= 12]),
                "right_residual_points": poly_residuals(rrf["poly"], t, [(x[0], x[4]) for x in right_samples[9:12] if len(right_samples) >= 12]),
            },
        })

    return {
        "wall_results": outputs,
        "wall_attempted": len(outputs),
        "wall_success": len([x for x in outputs if x.get("status") == "ok"]),
        "wall_replace_if_needed": len(outputs) > len(base_choices),
    }
