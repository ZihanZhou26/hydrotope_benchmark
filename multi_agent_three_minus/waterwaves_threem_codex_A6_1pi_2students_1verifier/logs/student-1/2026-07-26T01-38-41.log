def gauss_solve_exact(A: List[List[Fraction]], b: List[Fraction]):
    m = len(A)
    if m == 0:
        return True, []
    n = len(A[0])
    mat = [row[:] + [rhs] for row, rhs in zip(A, b)]
    row = 0
    pivot_cols = []

    for col in range(n):
        pivot = None
        for r in range(row, m):
            if mat[r][col] != 0:
                pivot = r
                break
        if pivot is None:
            continue
        mat[row], mat[pivot] = mat[pivot], mat[row]
        pv = mat[row][col]
        for c in range(col, n + 1):
            mat[row][c] /= pv
        for r in range(m):
            if r == row:
                continue
            f = mat[r][col]
            if f == 0:
                continue
            for c in range(col, n + 1):
                mat[r][c] -= f * mat[row][c]
        pivot_cols.append(col)
        row += 1
        if row == m:
            break

    for r in range(m):
        if all(mat[r][c] == 0 for c in range(n)) and mat[r][n] != 0:
            return False, []

    sol = [Fraction(0, 1)] * n
    for r in range(m):
        piv = None
        for c in range(n):
            if mat[r][c] != 0:
                piv = c
                break
        if piv is None:
            continue
        sol[piv] = mat[r][n]
    return True, sol


def feature_matrix(samples: Sequence[ExactSample], idxs: Sequence[int], em: int, ep: int):
    names: List[str] = []
    cols: List[List[Fraction]] = []
    uniq: Dict[Tuple[Fraction, ...], int] = {}

    for theta in ("min", "max"):
        for pref in pair_feature_names():
            vals = [feature_value(samples[i].omega, em, ep, theta, pref) for i in idxs]
            key = tuple(vals)
            if key in uniq:
                continue
            uniq[key] = len(cols)
            names.append(f"{pref}|{theta}|e_m={em}|e_p={ep}")
            cols.append(vals)

    rows: List[List[Fraction]] = []
    for r in range(len(idxs)):
        rows.append([col[r] for col in cols])
    return names, rows
