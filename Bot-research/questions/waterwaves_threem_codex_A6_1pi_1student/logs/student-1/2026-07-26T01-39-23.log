def _classify(records: List[dict]) -> Dict[str, object]:
    by_side: Dict[int, List[dict]] = {-1: [], 1: []}
    for rec in records:
        by_side[rec["side"]].append(rec)

    info = {
        "h_ratio_ok": True,
        "q_ratio_ok": True,
        "other_min_h_ok": True,
        "classification": "not_located",
    }

    h_rows = []
    q_rows = []
    other_rows = []
    for side in (-1, 1):
        rows = sorted(by_side[side], key=lambda x: x["decade"])
        if len(rows) == 0:
            info["h_ratio_ok"] = False
            info["q_ratio_ok"] = False
            return info

        h_rows.extend([r["float"]["h_abs"] for r in rows])
        q_rows.extend([r["float"]["q_abs"] for r in rows])
        other_rows.extend([r["float"]["other_min_h"] if "other_min_h" in r["float"] else 0.0 for r in rows])

        if not _ratio_check([r["float"]["h_abs"] for r in rows]):
            info["h_ratio_ok"] = False
        if not _ratio_check([r["float"]["q_abs"] for r in rows]):
            info["q_ratio_ok"] = False

    if other_rows:
        info["other_min_h_ok"] = min(other_rows) > 1e-8

    if not (info["h_ratio_ok"] and info["q_ratio_ok"] and info["other_min_h_ok"]):
        return info

    ah_vals = [abs(float(r["A_h"])) for r in records if "A_h" in r and abs(float(r["A_h"])) > 0]
    a_vals = [abs(float(r["A_im"])) for r in records if "A_im" in r and abs(float(r["A_im"])) > 0]

    if ah_vals and max(ah_vals) / min(ah_vals) < 5:
        info["classification"] = "simple"
    elif a_vals and (a_vals[-1] <= 2 * a_vals[0]):
        info["classification"] = "bounded_or_removable"
    else:
        info["classification"] = "non_scaling"

    return info
