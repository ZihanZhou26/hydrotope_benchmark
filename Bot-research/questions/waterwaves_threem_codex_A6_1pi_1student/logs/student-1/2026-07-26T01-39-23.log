    m = re.search(r"A_6\\s*=\\s*i\\s*\\*?\\s*\\(?\\s*([^)]\\n]*)\\s*\\)?", text)
    if m:
        return Fraction(0), _as_fraction(m.group(1))
    raise ValueError(f"unable to parse bg output: {text}")
