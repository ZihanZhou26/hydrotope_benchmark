WALL_CATALOG = common.build_wall_catalog()
PRIMES = (1_000_003, 1_000_033, 1_000_037)

HALF_WIDTH_DEFAULT = 72
LINE_MIN_POINTS = 145
LINE_MIN_COUNT = 6
HOLDOUT_FAMILY = 16
DEN_FP_MIN_HOLDOUT = 12
MAX_M_DEN = 66
